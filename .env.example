# CallSuraksha AI — server config (example only, NO real key here)
# On the Muse cloud VM the server uses the Secure Vault first (custom.gnani
# connector) and never needs a key in `.env`. GNANI_API_KEY below is ONLY
# the fallback for running the project elsewhere (e.g. a MacBook), where
# there is no Vault. Copy this file to `.env` in the app root ONLY on such
# a machine, and fill in the key there. `.env` is gitignored — the real key
# NEVER goes in chat, in git, or in browser code. Get the key from
# app.gnani.ai (Gnani APIs dashboard).
#
# PRODUCTION (Render/Railway): do NOT copy this file to the host. Set the
# variables in the host dashboard (Render: Environment). The Vault does
# NOT exist on a production host — GNANI_API_KEY is the ONLY way the
# production server gets its credential. Create a DEDICATED production
# key at app.gnani.ai (separate from the dev/Vault key) so it can be
# revoked independently. Never paste the key in chat or in render.yaml.

# Gnani API key (server-side only, header X-API-Key-ID) — local fallback
# + the production credential (set in the host's secret store, not here)
GNANI_API_KEY=

# Local server port (Vite dev proxy points /api here). Render/Railway set
# PORT automatically — do not hardcode it on the host.
PORT=3001

# Production only: NODE_ENV=production makes the server also serve the
# built Vite frontend (dist/) + SPA fallback from the same origin.
# Render sets NODE_ENV=production by default; set it explicitly anyway.
NODE_ENV=development

# Optional: bind host (default 0.0.0.0 — required on Render/Railway so
# the host's health check can reach the service).
HOST=0.0.0.0

# Optional CORS: leave EMPTY for same-origin deployment (recommended —
# frontend + backend on one service, no CORS needed). Set a
# comma-separated list of exact origins ONLY if the frontend is hosted
# on a different origin, e.g. ALLOWED_ORIGINS=https://callsuraksha.vercel.app
ALLOWED_ORIGINS=

# Optional staging gate: set BOTH to protect the whole service with
# HTTP basic auth (except /api/health, which the host health check
# needs). Off when either is empty. Use a strong random password.
STAGING_USER=
STAGING_PASS=
