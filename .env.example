# CallSuraksha AI — server config (example only, NO real key here)
# Copy this file to `.env` in the app root and fill in the real key there.
# `.env` is gitignored — the real key NEVER goes in chat, in git, or in
# browser code. Get the key from app.gnani.ai (Gnani APIs dashboard).

# Gnani API key (server-side only, header X-API-Key-ID)
GNANI_API_KEY=

# Local server port (Vite dev proxy points /api here)
PORT=3001
